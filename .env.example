# Razorpay Test Mode

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database

DATABASE_URL=sqlite:///./recoverai.db

# Required operator access. Generate a hash with: python -m scripts.hash_password
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=
OPERATOR_SESSION_HOURS=8
API_BASE_URL=http://127.0.0.1:8000
# Same-origin checkout needs no CORS entries. Add only trusted origins if needed.
ALLOWED_ORIGINS=[]

# Business policy defaults (Section 14 of spec)

HUMAN_REVIEW_TIMEOUT_HOURS=24
MAX_RECOVERY_WINDOW_DAYS=14
